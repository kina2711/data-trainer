{
  "name": "rabbit-data-trainer",
  "version": "3.0.0",
  "private": true,
  "description": "Rabbit Data curriculum, Second Brain and governed learning portal",
  "scripts": {
    "test": "make test",
    "inventory": "make inventory",
    "roadmap:diagrams": "python3 Tools/Curriculum/Build/render_roadmap_diagrams.py",
    "brain:index": "python3 Apps/SecondBrain/tools/build_index.py",
    "brain:web": "python3 Apps/SecondBrain/tools/serve.py",
    "brain:desktop": "electron Apps/SecondBrain/desktop/main.cjs",
    "brain:test": "npm run brain:index && node --check Apps/SecondBrain/web/app.js && node --check Apps/SecondBrain/desktop/main.cjs && node --check Apps/SecondBrain/desktop/preload.cjs && node --test Apps/SecondBrain/tests/app.test.mjs",
    "lectures:first10:build": "python3 Tools/Curriculum/Build/build_da_de_first_5_lessons.py",
    "lectures:first10:test": "python3 Tools/Curriculum/Build/build_da_de_first_5_lessons.py --check && python3 Tools/Curriculum/Build/validate_da_de_first_5_lessons.py",
    "lectures:authoring:test": "npm run brain:index && python3 Tools/Curriculum/Build/validate_lesson_authoring_standard.py",
    "portal:editorial:test": "npm run brain:index && python3 Tools/Curriculum/Build/validate_portal_editorial_standard.py"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "^4.5.1",
    "@mermaid-js/mermaid-cli": "^12.0.0",
    "dompurify": "^3.4.16",
    "electron": "^44.5.1",
    "lodash-es": "^4.18.1",
    "marked": "^4.3.0",
    "mermaid": "^12.1.0"
  }
}
